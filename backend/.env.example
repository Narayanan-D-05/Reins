# Copy to .env and fill in real values. .env is gitignored — never commit it.
# None of these are secrets (RPC URL and contract addresses are public),
# but keep them in .env rather than hardcoded so this backend can point at
# different networks without a code change.

PORT=8080
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Fill these in after running `forge script script/Deploy.s.sol:Deploy` in
# ../contracts and copying the logged addresses.
RECEIPT_BOOK_ADDRESS=
ATTESTOR_ADDRESS=
SETTLEMENT_GATE_ADDRESS=
FACTORY_ADDRESS=

# Deployed ERC-8004 Identity Registry on Monad Testnet (verified address;
# override only if targeting a different network).
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# GraphQL endpoint for the deployed Envio indexer (from the Envio Cloud
# dashboard's "Deployment Endpoint" field). Feeds the dashboard's live feed
# and at-risk meter. Optional — those routes are disabled without it.
ENVIO_GRAPHQL_ENDPOINT=
